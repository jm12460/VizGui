# Maintainer: jm12460 <jmccallu6@gmail.com>
#
# vizgui: stable release, built from the tagged source tarball.
# For the rolling build from the main branch see ../vizgui-git.
pkgname=vizgui
pkgver=0.2.0
pkgrel=1
pkgdesc="Cast local media to a SmartCast TV / Chromecast or VLC, with a remote, a phone web-remote, live transcoding, and SMB sources"
arch=('any')
url="https://github.com/jm12460/VizGui"
license=('MIT')
depends=(
    'python'
    'pyside6'
    'ffmpeg'       # live remux / transcode
    'vlc'          # VLC playback target
    'playerctl'    # MPRIS control of a hand-opened VLC
    'gvfs-smb'     # on-demand SMB mounts
    'python-qrcode'  # phone-remote pairing QR
    'go-chromecast-git'  # casting; the only AUR dep (builds from Go source)
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz::https://github.com/jm12460/VizGui/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c39a2d5b34f1cba437234b04373cce4c70bfa05f34482dd2fdec3be0a72843c3')

build() {
    cd "$srcdir/VizGui-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/VizGui-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 packaging/vizgui.desktop "$pkgdir/usr/share/applications/vizgui.desktop"
    install -Dm644 packaging/vizgui.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vizgui.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
