[Unit]
Description=VizGui headless casting server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# This template is for VizGui installed into the selected Python environment.
# Source checkouts also require WorkingDirectory=/absolute/path/to/vizgui.
# Use render_server_service.py to check paths and generate either variant.
# For a venv, select its own Python executable, not the system interpreter.
ExecStart=/usr/bin/python -m vizgui.server --no-print-pin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
